{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_SCAN_FOR_MODULES": "ON",
        "CMAKE_CXX_MODULE_STD": "ON"
      }
    }
  ]
}